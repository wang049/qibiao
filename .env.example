# 识别服务根地址（不要带 /v1）。未配时联调走本机。
# KROW_SERVER_URL=https://internal.example

# 对话模型 id，以对方清单为准
KROW_CHAT_MODEL=qwen2.5:7b

# 账号登录（与密钥二选一）
# KROW_USERNAME=
# KROW_PASSWORD=

# 或 Headless 密钥
# KROW_API_KEY=

# 登录页
KROW_GATEWAY_HOST=127.0.0.1
KROW_GATEWAY_PORT=18765

# 出表服务（只做健康检查，不改它的默认识别地址）
ELECTRICAL_BACKEND_URL=http://127.0.0.1:8765

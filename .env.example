# 云端识别（不要带 /v1）。本机 Mac 调试用这一项。
KROW_SERVER_URL=https://api.krow.cn

# 客户现场内网（只写在 Windows / 场所包装的 config.ini，不要在本机 export）
# KROW_SERVER_URL=https://rdapi.aurobaytech-t.com

# 对话模型 id，以 GET /v1/models 为准。deepseek-v4-pro、GLM-5.2 文本版不一定收图。
KROW_CHAT_MODEL=deepseek-v4-pro

# 扫描页走 SDK /v1/ocr（Mac 调试用本项指向 api.krow.cn；Windows 现场改 config.ini 的 server_url）。
# 现场须提供 /v1/ocr；没有则回退本机 RapidOCR。krow-ocr-table 只认字，不出 JSON 核对表。
# KROW_VISION_MODEL=krow-ocr-table

# 账号登录。页面上只支持邮箱/密码。
# KROW_USERNAME=
# KROW_PASSWORD=

# 登录页（客户端默认回环）
KROW_GATEWAY_HOST=127.0.0.1
KROW_GATEWAY_PORT=18765
# client=工位安装包；site=指定场所内网网页（须显式开启）
KROW_DELIVERY=client

# 云端单次生成最长约 290 秒
KROW_LLM_TIMEOUT=180

# 出表流水线所在的 electrical 工程（默认与本仓库同级）
# ELECTRICAL_ROOT=/Users/wwj/电子电器项目/electrical

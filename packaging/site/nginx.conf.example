# 场所内网 HTTPS 反代样例。应用只听 127.0.0.1:18765。
# 把 sor.internal.example 换成甲方内网域名，证书放到场所证书目录。
# 不要 listen 公网网卡；防火墙只放行场所内网。

upstream electrical_krow {
    server 127.0.0.1:18765;
}

server {
    listen 80;
    server_name sor.internal.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sor.internal.example;

    ssl_certificate     /etc/ssl/electrical-krow/fullchain.pem;
    ssl_certificate_key /etc/ssl/electrical-krow/privkey.pem;

    client_max_body_size 80m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://electrical_krow;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}
